        "class Calculadora:\n",
        "    def __init__(self):\n",
        "        self._historico = []  # atributo \"protegido\" (encapsulado)\n",
        "        self._operacoes = {\n",
        "            op.simbolo: op\n",
        "            for op in [Soma(), Subtracao(), Multiplicacao(),\n",
        "                       Divisao(), Potencia(), RaizQuadrada()]\n",
        "        }\n",
        "\n",
        "    def calcular(self, simbolo, *args):\n",
        "        if simbolo not in self._operacoes:\n",
        "            raise ValueError(f\"Operação '{simbolo}' não suportada.\")\n",
        "\n",
        "        resultado = self._operacoes[simbolo].executar(*args)\n",
        "        self._registrar(simbolo, args, resultado)\n",
        "        return resultado\n",
        "\n",
        "    def _registrar(self, simbolo, args, resultado):\n",
        "        if len(args) == 1:\n",
        "            texto = f\"{simbolo}({args[0]}) = {resultado}\"\n",
        "        else:\n",
        "            texto = f\"{args[0]} {simbolo} {args[1]} = {resultado}\"\n",
        "        self._historico.append(texto)\n",
        "\n",
        "    @property\n",
        "    def historico(self):\n",
        "        return list(self._historico)  # devolve cópia, protegendo o original\n",
        "\n",
        "    def operacoes_disponiveis(self):\n",
        "        return list(self._operacoes.keys())"
      ],
