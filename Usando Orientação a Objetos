        "from abc import ABC, abstractmethod\n",
        "\n",
        "\n",
        "class Operacao(ABC):\n",
        "    \"\"\"Classe abstrata: define o contrato que toda operação deve seguir.\"\"\"\n",
        "\n",
        "    simbolo = \"\"\n",
        "\n",
        "    @abstractmethod\n",
        "    def executar(self, *args):\n",
        "        pass\n",
        "\n",
        "\n",
        "class Soma(Operacao):\n",
        "    simbolo = \"+\"\n",
        "\n",
        "    def executar(self, a, b):\n",
        "        return a + b\n",
        "\n",
        "\n",
        "class Subtracao(Operacao):\n",
        "    simbolo = \"-\"\n",
        "\n",
        "    def executar(self, a, b):\n",
        "        return a - b\n",
        "\n",
        "\n",
        "class Multiplicacao(Operacao):\n",
        "    simbolo = \"*\"\n",
        "\n",
        "    def executar(self, a, b):\n",
        "        return a * b\n",
        "\n",
        "\n",
        "class Divisao(Operacao):\n",
        "    simbolo = \"/\"\n",
        "\n",
        "    def executar(self, a, b):\n",
        "        if b == 0:\n",
        "            raise ZeroDivisionError(\"Divisão por zero não é permitida.\")\n",
        "        return a / b\n",
        "\n",
        "\n",
        "class Potencia(Operacao):\n",
        "    simbolo = \"^\"\n",
        "\n",
        "    def executar(self, a, b):\n",
        "        return a ** b\n",
        "\n",
        "\n",
        "class RaizQuadrada(Operacao):\n",
        "    \"\"\"Raiz quadrada pelo método de Newton: x_novo = (x + n/x) / 2\"\"\"\n",
        "\n",
        "    simbolo = \"raiz\"\n",
        "\n",
        "    def __init__(self, tolerancia=1e-10, max_iteracoes=100):\n",
        "        self.tolerancia = tolerancia\n",
        "        self.max_iteracoes = max_iteracoes\n",
        "\n",
        "    def executar(self, n):\n",
        "        if n < 0:\n",
        "            raise ValueError(\"Não existe raiz quadrada real de número negativo.\")\n",
        "        if n == 0:\n",
        "            return 0.0\n",
        "\n",
        "        x = n if n >= 1 else 1.0  # chute inicial\n",
        "        for _ in range(self.max_iteracoes):\n",
        "            x_novo = (x + n / x) / 2\n",
        "            if abs(x_novo - x) < self.tolerancia:\n",
        "                return x_novo\n",
        "            x = x_novo\n",
        "        return x"
      ]
