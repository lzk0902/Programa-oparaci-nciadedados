        "Pergunta: em quais meses as vendas de Notebook cresceram ou caíram em relação ao mês anterior, e em que intensidade?"
      ],
      "metadata": {
        "id": "oaUEsC1qshPs"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "variacao = df[\"Notebook\"].pct_change() * 100  # variação % em relação ao mês anterior\n",
        "meses = df[\"Mes\"][1:]\n",
        "valores = variacao[1:]\n",
        "\n",
        "cores = np.where(valores >= 0, \"#55A868\", \"#C44E52\")\n",
        "\n",
        "plt.figure(figsize=(8, 5))\n",
        "barras = plt.bar(meses, valores, color=cores)\n",
        "plt.bar_label(barras, fmt=\"%.1f%%\")\n",
        "plt.axhline(0, color=\"black\", linewidth=0.8)\n",
        "\n",
        "plt.title(\"Notebook: variação percentual das vendas em relação ao mês anterior\")\n",
        "plt.xlabel(\"Mês\")\n",
        "plt.ylabel(\"Variação (%)\")\n",
        "plt.show()"
