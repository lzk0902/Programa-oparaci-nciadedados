        "import json\n",
        "from urllib.parse import quote\n",
        "from selenium import webdriver\n",
        "from selenium.webdriver.common.by import By\n",
        "\n",
        "cidade = input(\"Cidade: \").strip()\n",
        "\n",
        "opcoes = webdriver.ChromeOptions()\n",
        "opcoes.binary_location = \"/usr/bin/google-chrome\"\n",
        "opcoes.add_argument(\"--headless=new\")\n",
        "opcoes.add_argument(\"--no-sandbox\")\n",
        "opcoes.add_argument(\"--disable-dev-shm-usage\")\n",
        "\n",
        "driver = webdriver.Chrome(options=opcoes)\n",
        "\n",
        "try:\n",
        "    driver.get(f\"https://wttr.in/{quote(cidade)}?format=j1\")\n",
        "    texto = driver.find_element(By.TAG_NAME, \"body\").text\n",
        "    hoje = json.loads(texto)[\"weather\"][0]\n",
        "\n",
        "    print(f\"\\nPrevisão de hoje em {cidade}:\")\n",
        "    print(f\"Mínima: {hoje['mintempC']} °C\")\n",
        "    print(f\"Máxima: {hoje['maxtempC']} °C\")\n",
        "except Exception as e:\n",
        "    print(\"Não foi possível obter a previsão:\", e)\n",
        "finally:\n",
        "    driver.quit()"
