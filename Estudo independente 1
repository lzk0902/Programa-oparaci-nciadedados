        "# ---(Desafio 2) ----------\n",
        "\n",
        "def cadastrar_produto(estoque, codigo, nome, preco, quantidade):\n",
        "    \"\"\"Adiciona ou atualiza um produto no dicionário de estoque.\"\"\"\n",
        "    estoque[codigo] = {\n",
        "        \"nome\": nome,\n",
        "        \"preco\": preco,\n",
        "        \"quantidade\": quantidade\n",
        "    }\n",
        "\n",
        "\n",
        "def consultar_produto(estoque, codigo):\n",
        "    \"\"\"Retorna os dados de um produto pelo código, ou None se não existir.\"\"\"\n",
        "    return estoque.get(codigo)\n",
        "\n",
        "\n",
        "def calcular_valor_total_estoque(estoque):\n",
        "    \"\"\"Retorna o valor total do estoque (soma de preco * quantidade de cada produto).\"\"\"\n",
        "    total = 0.0\n",
        "    for produto in estoque.values():\n",
        "        total += produto[\"preco\"] * produto[\"quantidade\"]\n",
        "    return total\n",
        "\n",
        "\n",
        "def produto_maior_valor_unitario(estoque):\n",
        "    \"\"\"Retorna (codigo, dados) do produto com maior preço unitário.\"\"\"\n",
        "    if not estoque:\n",
        "        return None\n",
        "    codigo_maior = max(estoque, key=lambda cod: estoque[cod][\"preco\"])\n",
        "    return codigo_maior, estoque[codigo_maior]\n",
        "def ler_dados_produto():\n",
        "    \"\"\"Lê do usuário os dados de um novo produto e retorna como tupla.\"\"\"\n",
        "    codigo = input(\"Código do produto: \").strip()\n",
        "    nome = input(\"Nome do produto: \").strip()\n",
        "\n",
        "    while True:\n",
        "        try:\n",
        "            preco = float(input(\"Preço unitário: \"))\n",
        "            if preco >= 0:\n",
        "                break\n",
        "            print(\"O preço não pode ser negativo.\")\n",
        "        except ValueError:\n",
        "            print(\"Digite um valor numérico válido.\")\n",
        "\n",
        "    while True:\n",
        "        try:\n",
        "            quantidade = int(input(\"Quantidade em estoque: \"))\n",
        "            if quantidade >= 0:\n",
        "                break\n",
        "            print(\"A quantidade não pode ser negativa.\")\n",
        "        except ValueError:\n",
        "            print(\"Digite um número inteiro válido.\")\n",
        "\n",
        "    return codigo, nome, preco, quantidade\n",
        "def exibir_menu():\n",
        "    print(\"\\n=== Menu - Cadastro de Produtos ===\")\n",
        "    print(\"1 - Cadastrar produto\")\n",
        "    print(\"2 - Consultar produto por código\")\n",
        "    print(\"3 - Valor total do estoque\")\n",
        "    print(\"4 - Produto de maior valor unitário\")\n",
        "    print(\"0 - Sair\")\n",
        "\n",
        "\n",
        "def main_desafio2():\n",
        "    estoque = {}\n",
        "\n",
        "    while True:\n",
        "        exibir_menu()\n",
        "        opcao = input(\"Escolha uma opção: \").strip()\n",
        "\n",
        "        if opcao == \"1\":\n",
        "            codigo, nome, preco, quantidade = ler_dados_produto()\n",
        "            cadastrar_produto(estoque, codigo, nome, preco, quantidade)\n",
        "            print(\"Produto cadastrado com sucesso!\")\n",
        "\n",
        "        elif opcao == \"2\":\n",
        "            codigo = input(\"Digite o código do produto: \").strip()\n",
        "            produto = consultar_produto(estoque, codigo)\n",
        "            if produto:\n",
        "                print(f\"Nome: {produto['nome']} | Preço: R$ {produto['preco']:.2f} | Quantidade: {produto['quantidade']}\")\n",
        "            else:\n",
        "                print(\"Produto não encontrado.\")\n",
        "\n",
        "        elif opcao == \"3\":\n",
        "            total = calcular_valor_total_estoque(estoque)\n",
        "            print(f\"Valor total do estoque: R$ {total:.2f}\")\n",
        "\n",
        "        elif opcao == \"4\":\n",
        "            resultado = produto_maior_valor_unitario(estoque)\n",
        "            if resultado:\n",
        "                codigo, produto = resultado\n",
        "                print(f\"Produto de maior valor unitário: {produto['nome']} (código {codigo}) - R$ {produto['preco']:.2f}\")\n",
        "            else:\n",
        "                print(\"Nenhum produto cadastrado.\")\n",
        "\n",
        "        elif opcao == \"0\":\n",
        "            print(\"Encerrando o programa. Até mais!\")\n",
        "            break\n",
        "\n",
        "        else:\n",
        "            print(\"Opção inválida, tente novamente.\")\n",
        "estoque_teste = {}\n",
        "cadastrar_produto(estoque_teste, \"P001\", \"Teclado\", 89.90, 15)\n",
        "cadastrar_produto(estoque_teste, \"P002\", \"Monitor\", 799.00, 4)\n",
        "cadastrar_produto(estoque_teste, \"P003\", \"Mouse\", 49.90, 30)\n",
        "\n",
        "print(\"Consulta ao código P002:\", consultar_produto(estoque_teste, \"P002\"))\n",
        "print(f\"Valor total do estoque: R$ {calcular_valor_total_estoque(estoque_teste):.2f}\")\n",
        "\n",
        "codigo_top, produto_top = produto_maior_valor_unitario(estoque_teste)\n",
        "print(f\"Produto de maior valor unitário: {produto_top['nome']} (código {codigo_top}) - R$ {produto_top['preco']:.2f}\")\n"
