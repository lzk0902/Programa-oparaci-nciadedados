        "# -----(Desafio 1) ----------\n",
        "\n",
        "def calcular_maior_nota(notas):\n",
        "    \"\"\"Retorna a maior nota da lista.\"\"\"\n",
        "    return max(notas)\n",
        "\n",
        "\n",
        "def calcular_menor_nota(notas):\n",
        "    \"\"\"Retorna a menor nota da lista.\"\"\"\n",
        "    return min(notas)\n",
        "\n",
        "\n",
        "def calcular_media(notas):\n",
        "    \"\"\"Retorna a média aritmética das notas da turma.\"\"\"\n",
        "    return sum(notas) / len(notas)\n",
        "\n",
        "\n",
        "def contar_aprovados(notas, nota_corte=6.0):\n",
        "    \"\"\"Conta quantos estudantes possuem nota >= nota_corte.\"\"\"\n",
        "    aprovados = 0\n",
        "    for nota in notas:\n",
        "        if nota >= nota_corte:\n",
        "            aprovados += 1\n",
        "    return aprovados\n",
        "\n",
        "\n",
        "def contar_reprovados(notas, nota_corte=6.0):\n",
        "    \"\"\"Conta quantos estudantes possuem nota < nota_corte.\"\"\"\n",
        "    return len(notas) - contar_aprovados(notas, nota_corte)\n",
        "def ler_quantidade_estudantes():\n",
        "    \"\"\"Solicita a quantidade de estudantes, garantindo um valor inteiro positivo.\"\"\"\n",
        "    while True:\n",
        "        try:\n",
        "            quantidade = int(input(\"Quantos estudantes possui a turma? \"))\n",
        "            if quantidade > 0:\n",
        "                return quantidade\n",
        "            print(\"A quantidade deve ser maior que zero.\")\n",
        "        except ValueError:\n",
        "            print(\"Digite um número inteiro válido.\")\n",
        "\n",
        "\n",
        "def ler_notas(quantidade):\n",
        "    \"\"\"Lê 'quantidade' notas do usuário e as armazena em uma lista, validando o intervalo 0-10.\"\"\"\n",
        "    notas = []\n",
        "    for i in range(1, quantidade + 1):\n",
        "        while True:\n",
        "            try:\n",
        "                nota = float(input(f\"Nota do estudante {i}: \"))\n",
        "                if 0 <= nota <= 10:\n",
        "                    notas.append(nota)\n",
        "                    break\n",
        "                print(\"A nota deve estar entre 0 e 10.\")\n",
        "            except ValueError:\n",
        "                print(\"Digite um número válido.\")\n",
        "    return notas\n",
        "def main_desafio1():\n",
        "    print(\"=== Análise de notas de uma turma ===\\n\")\n",
        "\n",
        "    quantidade = ler_quantidade_estudantes()\n",
        "    notas = ler_notas(quantidade)\n",
        "\n",
        "    maior = calcular_maior_nota(notas)\n",
        "    menor = calcular_menor_nota(notas)\n",
        "    media = calcular_media(notas)\n",
        "    aprovados = contar_aprovados(notas)\n",
        "    reprovados = contar_reprovados(notas)\n",
        "\n",
        "    print(\"\\n--- Resultado ---\")\n",
        "    print(f\"Notas registradas: {notas}\")\n",
        "    print(f\"Maior nota: {maior:.1f}\")\n",
        "    print(f\"Menor nota: {menor:.1f}\")\n",
        "    print(f\"Média da turma: {media:.2f}\")\n",
        "    print(f\"Aprovados (nota >= 6.0): {aprovados}\")\n",
        "    print(f\"Reprovados: {reprovados}\")\n",
        "notas_teste = [7.5, 3.2, 9.0, 5.9, 6.0, 10.0, 4.4]\n",
        "\n",
        "print(\"Notas de teste:\", notas_teste)\n",
        "print(\"Maior nota:\", calcular_maior_nota(notas_teste))\n",
        "print(\"Menor nota:\", calcular_menor_nota(notas_teste))\n",
        "print(f\"Média: {calcular_media(notas_teste):.2f}\")\n",
        "print(\"Aprovados:\", contar_aprovados(notas_teste))\n",
        "print(\"Reprovados:\", contar_reprovados(notas_teste))"
