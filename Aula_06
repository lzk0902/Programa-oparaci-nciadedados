        "import random\n",
        "\n",
        "historico = []\n",
        "\n",
        "continuar = \"s\"\n",
        "\n",
        "while continuar == \"s\":\n",
        "    valor = random.randint(0, 15)\n",
        "    tentativas = 0\n",
        "\n",
        "    while True:\n",
        "        fds = int(input(\"Informe um valor de 0 a 15: \"))\n",
        "        tentativas += 1\n",
        "        if fds == valor:\n",
        "            print(f\"Você acertou! O número era {valor}. Tentativas: {tentativas}\")\n",
        "            break\n",
        "        else:\n",
        "            print(\"Errado, tente novamente.\")\n",
        "\n",
        "\n",
        "    with open(\"historico.txt\", \"a\") as arquivo:\n",
        "        arquivo.write(f\"Número: {valor} | Tentativas: {tentativas}\\n\")\n",
        "\n",
        "    historico.append(f\"Número: {valor} | Tentativas: {tentativas}\")\n",
        "\n",
        "    continuar = input(\"Quer tentar de novo? (s/n): \")\n",
        "\n",
        "\n",
        "print(\"\\n--- Histórico ---\")\n",
        "for linha in historico:\n",
        "    print(linha)"
