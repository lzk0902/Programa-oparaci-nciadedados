        "import csv\n",
        "\n",
        "lista_compras = []\n",
        "continuar = \"s\"\n",
        "\n",
        "while continuar == \"s\":\n",
        "    item = input(\"Nome do item: \")\n",
        "    quantidade = int(input(\"Quantidade: \"))\n",
        "    valor = float(input(\"Valor unitário: \"))\n",
        "\n",
        "    lista_compras.append([item, quantidade, valor])\n",
        "\n",
        "    continuar = input(\"Adicionar outro item? (s/n): \")\n",
        "\n",
        "\n",
        "total = 0\n",
        "for item, quantidade, valor in lista_compras:\n",
        "    total += quantidade * valor\n",
        "\n",
        "print(f\"\\nValor total das compras: R$ {total:.2f}\")\n",
        "\n",
        "\n",
        "with open(\"lista_compras.csv\", \"w\", newline=\"\") as arquivo:\n",
        "    escritor = csv.writer(arquivo)\n",
        "    escritor.writerow([\"Item\", \"Quantidade\", \"Valor Unitário\"])\n",
        "    for linha in lista_compras:\n",
        "        escritor.writerow(linha)\n",
        "\n",
        "print(\"Lista salva em lista_compras.csv\")\n"
